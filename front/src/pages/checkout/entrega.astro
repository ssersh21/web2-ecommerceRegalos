---
export const prerender = false;
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Datos de Entrega - RegalosApp">
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="bg-stone-100 p-4 rounded-xl border border-stone-200 text-sm text-stone-700">
      <p class="font-bold">Compra asociada a</p>
      <p id="userEmail">Cargando...</p>
    </div>

    <div class="bg-white p-8 rounded-2xl shadow-sm border border-stone-200 space-y-6">
      <div>
        <h1 class="text-2xl font-bold text-stone-900">Datos de entrega</h1>
        <p class="text-xs text-stone-500 mt-1">Primero capturamos la entrega. Todavía no se realiza ningún pago.</p>
      </div>

      <form id="deliveryForm" class="space-y-4 text-sm">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-stone-700 mb-1">Destinatario</label>
            <input type="text" id="destinatario" required minlength="2" maxlength="100" class="w-full border border-stone-300 rounded-xl p-3 focus:outline-none focus:border-stone-500" />
          </div>
          <div>
            <label class="block font-bold text-stone-700 mb-1">Teléfono</label>
            <input type="tel" id="telefono" required minlength="7" maxlength="30" class="w-full border border-stone-300 rounded-xl p-3 focus:outline-none focus:border-stone-500" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-stone-700 mb-1">Dirección de entrega</label>
          <textarea id="direccion" rows="3" minlength="8" maxlength="240" placeholder="Calle, número, colonia y referencias" required class="w-full border border-stone-300 rounded-xl p-3 focus:outline-none focus:border-stone-500"></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-stone-700 mb-1">Fecha de entrega</label>
            <input type="date" id="fecha" required class="w-full border border-stone-300 rounded-xl p-3 focus:outline-none focus:border-stone-500" />
          </div>
          <div>
            <label class="block font-bold text-stone-700 mb-1">Horario preferido</label>
            <select id="horario" class="w-full border border-stone-300 rounded-xl p-3 focus:outline-none focus:border-stone-500">
              <option value="Sin preferencia">Sin preferencia</option>
              <option value="09:00-12:00">09:00 - 12:00</option>
              <option value="12:00-15:00">12:00 - 15:00</option>
              <option value="15:00-18:00">15:00 - 18:00</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-bold text-stone-700 mb-1">Mensaje para tarjeta (opcional)</label>
          <textarea id="mensaje" rows="2" maxlength="300" placeholder="Escribe tu dedicatoria..." class="w-full border border-stone-300 rounded-xl p-3 focus:outline-none focus:border-stone-500"></textarea>
        </div>

        <div class="flex justify-end pt-4">
          <button type="submit" class="bg-stone-800 text-white font-bold px-8 py-3 rounded-xl hover:bg-stone-900 transition-colors">
            Revisar pedido
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { obtenerToken, obtenerUsuario, redirigirALogin } from '../../lib/api';

    const usuario = obtenerUsuario();
    const carrito = JSON.parse(localStorage.getItem('cart') || '[]');

    if (!obtenerToken() || !usuario) {
      redirigirALogin();
    } else if (carrito.length === 0) {
      window.location.href = '/carrito';
    } else {
      const campo = (id: string) => document.getElementById(id) as HTMLInputElement;
      const guardado = JSON.parse(localStorage.getItem('deliveryData') || '{}');

      document.getElementById('userEmail')!.textContent = `${usuario.nombre} (${usuario.email})`;

      const hoy = new Date();
      const hoyIso = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
      campo('fecha').min = hoyIso;

      campo('destinatario').value = guardado.destinatario || usuario.nombre || '';
      campo('telefono').value = guardado.telefono || '';
      campo('direccion').value = guardado.direccion || '';
      campo('fecha').value = guardado.fecha && guardado.fecha >= hoyIso ? guardado.fecha : '';
      campo('horario').value = guardado.horario || 'Sin preferencia';
      campo('mensaje').value = guardado.mensaje || '';

      document.getElementById('deliveryForm')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const datos = {
          destinatario: campo('destinatario').value.trim(),
          telefono: campo('telefono').value.trim(),
          direccion: campo('direccion').value.trim(),
          fecha: campo('fecha').value,
          horario: campo('horario').value,
          mensaje: campo('mensaje').value.trim(),
        };
        localStorage.setItem('deliveryData', JSON.stringify(datos));
        window.location.href = '/checkout/verificacion';
      });
    }
  </script>
</MainLayout>
