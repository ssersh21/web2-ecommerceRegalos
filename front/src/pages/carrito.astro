---
export const prerender = false;
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Carrito de Compras - RegalosApp">
  <div class="max-w-4xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold text-stone-900">Tu Carrito de Compras</h1>

    <!-- Mensaje si el carrito está vacío -->
    <div id="cartEmpty" class="bg-white p-12 text-center rounded-2xl border border-stone-200 hidden">
      <p class="text-stone-500 font-semibold mb-4">Tu carrito está vacío</p>
      <a href="/" class="inline-block bg-stone-800 text-white font-bold px-6 py-2.5 rounded-xl text-sm hover:bg-stone-900 transition-colors">
        Explorar productos
      </a>
    </div>

    <!-- Contenido del carrito -->
    <div id="cartContent" class="grid grid-cols-1 lg:grid-cols-3 gap-6 hidden">
      <!-- Lista de ítems -->
      <div id="cartItemsList" class="lg:col-span-2 space-y-4"></div>

      <!-- Resumen del pedido -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm h-fit space-y-4">
        <h2 class="font-bold text-stone-900 text-lg border-b border-stone-100 pb-3">Resumen del pedido</h2>
        
        <div class="flex justify-between text-sm text-stone-600">
          <span>Subtotal</span>
          <span id="subtotalAmount" class="font-bold text-stone-900">$0 MXN</span>
        </div>

        <div class="flex justify-between text-sm text-stone-600">
          <span>Envío</span>
          <span class="text-emerald-600 font-bold">Gratis</span>
        </div>

        <div class="border-t border-stone-100 pt-3 flex justify-between font-extrabold text-stone-900 text-lg">
          <span>Total</span>
          <span id="totalAmount" class="text-stone-900">$0 MXN</span>
        </div>

        <button id="checkoutBtn" class="w-full mt-4 bg-indigo-900 text-white font-bold py-3.5 rounded-xl hover:bg-indigo-950 transition-colors text-sm">
          Proceder al Pago
        </button>
      </div>
    </div>
  </div>

  <script>
    import { escaparHtml, urlImagen } from '../lib/api';

    function renderCart() {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const cartEmpty = document.getElementById('cartEmpty');
      const cartContent = document.getElementById('cartContent');
      const cartItemsList = document.getElementById('cartItemsList');
      const subtotalAmount = document.getElementById('subtotalAmount');
      const totalAmount = document.getElementById('totalAmount');

      if (!cartEmpty || !cartContent || !cartItemsList || !subtotalAmount || !totalAmount) return;

      if (cart.length === 0) {
        cartEmpty.classList.remove('hidden');
        cartContent.classList.add('hidden');
        return;
      }

      cartEmpty.classList.add('hidden');
      cartContent.classList.remove('hidden');

      let total = 0;
      cartItemsList.innerHTML = cart.map((item: any) => {
        const itemTotal = item.precio * item.cantidad;
        total += itemTotal;
        return `
          <div class="bg-white p-4 rounded-2xl shadow-sm border border-stone-200 flex items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 bg-stone-100 rounded-xl overflow-hidden flex-shrink-0 flex items-center justify-center">
                ${item.imagen ? `<img src="${escaparHtml(urlImagen(item.imagen))}" class="w-full h-full object-cover"/>` : '<span class="text-xs text-stone-400">Sin foto</span>'}
              </div>
              <div>
                <h3 class="font-bold text-stone-900 text-sm">${escaparHtml(item.nombre)}</h3>
                <p class="text-xs text-stone-500 mt-0.5">$${item.precio} MXN c/u</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="flex items-center border border-stone-200 rounded-lg overflow-hidden">
                <button class="decrease-btn px-2.5 py-1 text-stone-600 hover:bg-stone-100 text-xs font-bold" data-id="${escaparHtml(item.id)}">-</button>
                <span class="px-3 text-xs font-semibold text-stone-800">${item.cantidad}</span>
                <button class="increase-btn px-2.5 py-1 text-stone-600 hover:bg-stone-100 text-xs font-bold" data-id="${escaparHtml(item.id)}">+</button>
              </div>
              <span class="font-extrabold text-stone-900 text-sm w-20 text-right">$${itemTotal}</span>
              <button class="remove-btn text-stone-400 hover:text-rose-600 text-xs font-bold px-1" data-id="${escaparHtml(item.id)}">✕</button>
            </div>
          </div>
        `;
      }).join('');

      subtotalAmount.textContent = `$${total} MXN`;
      totalAmount.textContent = `$${total} MXN`;

      document.querySelectorAll('.increase-btn').forEach(btn => {
        btn.addEventListener('click', () => updateQty(btn.getAttribute('data-id'), 1));
      });
      document.querySelectorAll('.decrease-btn').forEach(btn => {
        btn.addEventListener('click', () => updateQty(btn.getAttribute('data-id'), -1));
      });
      document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', () => removeItem(btn.getAttribute('data-id')));
      });
    }

    function updateQty(id: string | null, delta: number) {
      if (!id) return;
      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const item = cart.find((i: any) => String(i.id) === String(id));
      if (item) {
        item.cantidad += delta;
        if (item.cantidad <= 0) {
          cart = cart.filter((i: any) => String(i.id) !== String(id));
        }
        localStorage.setItem('cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('cart-updated'));
        renderCart();
      }
    }

    function removeItem(id: string | null) {
      if (!id) return;
      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      cart = cart.filter((i: any) => String(i.id) !== String(id));
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));
      renderCart();
    }

    document.getElementById('checkoutBtn')?.addEventListener('click', () => {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      if (cart.length === 0) return;
      window.location.href = '/checkout/entrega';
    });

    renderCart();
  </script>
</MainLayout>