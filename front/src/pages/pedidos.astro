---
export const prerender = false;
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Mis Pedidos - RegalosApp">
  <div class="max-w-4xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold text-stone-900 mb-4">Mis Pedidos</h1>

    <p id="errorPedidos" class="hidden bg-rose-50 border border-rose-200 text-rose-700 text-sm font-semibold p-3 rounded-xl"></p>

    <div id="noOrders" class="bg-white p-12 text-center rounded-2xl border border-stone-200 hidden">
      <p class="text-stone-500 font-semibold">No tienes pedidos registrados aún.</p>
      <a href="/" class="inline-block mt-4 bg-stone-800 text-white font-bold px-6 py-2.5 rounded-xl text-sm">Explorar catálogo</a>
    </div>

    <div id="ordersList" class="space-y-6"></div>
  </div>

  <script>
    import { consultarApi, escaparHtml, obtenerToken, redirigirALogin } from '../lib/api';

    const pasos = ['Pago aprobado', 'En preparación', 'Listo para entrega', 'Enviado', 'Entregado'];
    const pasoPorEstado: Record<string, number> = {
      PENDIENTE_PAGO: 0, PAGO_FALLIDO: 0, CANCELADO: 0,
      PAGADO: 1, EN_PREPARACION: 2, LISTO: 3, ENVIADO: 4, ENTREGADO: 5,
    };
    const etiquetaEstado: Record<string, string> = {
      PENDIENTE_PAGO: 'Pendiente de pago', PAGO_FALLIDO: 'Pago fallido', CANCELADO: 'Cancelado',
      PAGADO: 'Pago aprobado', EN_PREPARACION: 'En preparación', LISTO: 'Listo para entrega',
      ENVIADO: 'Enviado', ENTREGADO: 'Entregado',
    };
    const colorEstado = (estado: string) =>
      estado === 'CANCELADO' || estado === 'PAGO_FALLIDO' ? 'bg-rose-100 text-rose-800'
      : estado === 'PENDIENTE_PAGO' ? 'bg-amber-100 text-amber-800'
      : 'bg-emerald-100 text-emerald-800';

    function dibujarPedido(pedido: any) {
      const paso = pasoPorEstado[pedido.status] ?? 0;
      const pagos = (pedido.pagos || []).map((p: any) => `
        <p>${escaparHtml(p.proveedor.replace('_', ' '))} · ${escaparHtml(p.status)} · ${escaparHtml(p.referencia)}</p>
      `).join('');

      return `
        <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm space-y-6">
          <div class="flex justify-between items-center border-b border-stone-100 pb-4">
            <div>
              <span class="inline-block ${colorEstado(pedido.status)} text-xs font-bold px-3 py-1 rounded-full mb-1">${escaparHtml(etiquetaEstado[pedido.status] || pedido.status)}</span>
              <h2 class="text-xl font-bold text-stone-900">Pedido #${escaparHtml(pedido.id)}</h2>
            </div>
            <span class="text-2xl font-extrabold text-stone-900">$${Number(pedido.total).toFixed(2)}</span>
          </div>

          <div class="grid grid-cols-5 gap-2 text-center relative my-6">
            ${pasos.map((nombrePaso, idx) => `
              <div class="flex flex-col items-center">
                <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs ${idx + 1 <= paso ? 'bg-emerald-600 text-white' : 'bg-stone-200 text-stone-500'}">
                  ${idx + 1}
                </div>
                <span class="text-[10px] text-stone-500 mt-2 font-medium">${nombrePaso}</span>
              </div>
            `).join('')}
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-stone-600 border-t border-stone-100 pt-4">
            <div>
              <p class="font-bold text-stone-900 text-sm mb-1">Entrega</p>
              <p class="font-bold uppercase text-stone-800">${escaparHtml(pedido.destinatario)}</p>
              <p>${escaparHtml(pedido.direccion)}</p>
              <p class="mt-1 text-stone-400">${escaparHtml(pedido.fechaEntrega)} · ${escaparHtml(pedido.horarioEntrega || '')}</p>
              ${pedido.mensajeTarjeta ? `<p class="mt-1 italic">"${escaparHtml(pedido.mensajeTarjeta)}"</p>` : ''}
            </div>

            <div>
              <p class="font-bold text-stone-900 text-sm mb-1">Productos</p>
              ${(pedido.detalles || []).map((d: any) => `
                <p>${d.cantidad} × ${escaparHtml(d.producto.nombre)}</p>
              `).join('')}
            </div>
          </div>

          ${pagos ? `
            <div class="border-t border-stone-100 pt-3 text-xs text-stone-400 space-y-1">
              <p class="font-bold">Intentos de pago</p>
              ${pagos}
            </div>
          ` : ''}
        </div>
      `;
    }

    async function cargarPedidos() {
      if (!obtenerToken()) {
        redirigirALogin();
        return;
      }

      const aviso = document.getElementById('errorPedidos')!;
      try {
        const datos = await consultarApi(`
          query MisPedidos {
            pedidos {
              id total status destinatario direccion fechaEntrega horarioEntrega mensajeTarjeta
              detalles { cantidad producto { nombre } }
              pagos { proveedor status referencia }
            }
          }
        `);

        if (datos.pedidos.length === 0) {
          document.getElementById('noOrders')!.classList.remove('hidden');
          return;
        }
        document.getElementById('ordersList')!.innerHTML = datos.pedidos.map(dibujarPedido).join('');
      } catch (err) {
        aviso.textContent = (err as Error).message;
        aviso.classList.remove('hidden');
      }
    }

    cargarPedidos();
  </script>
</MainLayout>
