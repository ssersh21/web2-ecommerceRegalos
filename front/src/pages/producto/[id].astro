---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import { urlImagen } from '../../lib/api';

const { id } = Astro.params;
let producto: any = null;

try {
  const response = await fetch(import.meta.env.PUBLIC_API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      query: `
        query ObtenerProducto($id: ID!) {
          producto(id: $id) {
            id
            nombre
            descripcion
            precio
            stock
            imagen
            categoria {
              id
              nombre
            }
          }
        }
      `,
      variables: { id }
    })
  });

  const { data } = await response.json();
  producto = data?.producto;
} catch (error) {
  console.error("Error al obtener el producto:", error);
}
---

<MainLayout title={producto ? `${producto.nombre} - RegalosApp` : 'Producto no encontrado'}>
  <div class="max-w-4xl mx-auto">
    <a href="/" class="inline-flex items-center text-sm font-semibold text-indigo-600 hover:text-indigo-800 mb-6 transition-colors">
      ← Volver al Catálogo
    </a>

    {producto ? (
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden grid grid-cols-1 md:grid-cols-2 gap-8 p-6">
        <div class="flex items-center justify-center bg-gray-50 rounded-xl overflow-hidden min-h-[300px]">
          {producto.imagen ? (
            <img src={urlImagen(producto.imagen) ?? undefined} alt={producto.nombre} class="w-full h-80 object-cover" />
          ) : (
            <div class="h-80 flex items-center justify-center text-gray-400">Sin imagen</div>
          )}
        </div>

        <div class="flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
              {producto.categoria?.nombre || 'General'}
            </span>
            <h1 class="text-3xl font-bold text-gray-900 mt-3">{producto.nombre}</h1>
            <p class="text-gray-600 leading-relaxed mt-3">{producto.descripcion}</p>
            <p class="text-3xl font-extrabold text-indigo-600 mt-4">${producto.precio} MXN</p>
            <p class="text-sm text-gray-500 mt-2">Stock disponible: <span class="font-semibold text-gray-700">{producto.stock} unidades</span></p>
          </div>

          <div class="mt-8">
            <div class="mb-3 flex items-center justify-between rounded-xl border border-gray-200 bg-gray-50 px-4 py-3">
              <span class="text-sm font-semibold text-gray-600">Cantidad en carrito</span>
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  id="detailDecreaseBtn"
                  class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 font-bold text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
                  aria-label="Quitar una unidad del carrito"
                  disabled
                >−</button>
                <span id="detailCartQuantity" class="min-w-5 text-center text-sm font-bold text-gray-800">0</span>
                <button
                  type="button"
                  id="detailIncreaseBtn"
                  class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 font-bold text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
                  aria-label="Agregar una unidad al carrito"
                  data-stock={producto.stock}
                  disabled={producto.stock < 1}
                >+</button>
              </div>
            </div>
            <button 
              id="detailAddToCartBtn"
              class="w-full bg-indigo-600 text-white py-3 rounded-xl font-bold shadow hover:bg-indigo-700 transition-all active:scale-95 disabled:cursor-not-allowed disabled:opacity-50"
              data-id={producto.id}
              data-nombre={producto.nombre}
              data-precio={producto.precio}
              data-imagen={urlImagen(producto.imagen)}
              data-stock={producto.stock}
              disabled={producto.stock < 1}
            >
              Agregar al Carrito
            </button>
          </div>
        </div>
      </div>
    ) : (
      <div class="bg-white p-12 text-center rounded-2xl shadow-sm border border-gray-100">
        <h2 class="text-2xl font-bold text-gray-800">Producto no encontrado</h2>
        <p class="text-gray-500 mt-2">El producto solicitado no existe o no está disponible.</p>
      </div>
    )}
  </div>

  <script>
    const btn = document.getElementById('detailAddToCartBtn') as HTMLButtonElement | null;
    const menos = document.getElementById('detailDecreaseBtn') as HTMLButtonElement | null;
    const mas = document.getElementById('detailIncreaseBtn') as HTMLButtonElement | null;
    const cantidadLabel = document.getElementById('detailCartQuantity');
    const leerCarrito = () => JSON.parse(localStorage.getItem('cart') || '[]');

    function actualizarCantidad() {
      if (!btn || !menos || !mas || !cantidadLabel) return;
      const id = btn.dataset.id;
      const stock = Number(btn.dataset.stock || 0);
      const cantidad = Number(leerCarrito().find((item: any) => String(item.id) === id)?.cantidad || 0);
      cantidadLabel.textContent = String(cantidad);
      menos.disabled = cantidad <= 0;
      mas.disabled = cantidad >= stock;
      btn.disabled = stock < 1 || cantidad >= stock;
    }

    function cambiarCantidad(delta: number) {
      if (!btn) return;
      const { id, nombre, imagen } = btn.dataset;
      if (!id) return;
      const precio = Number(btn.dataset.precio || 0);
      const stock = Number(btn.dataset.stock || 0);
      const cart = leerCarrito();
      const item = cart.find((product: any) => String(product.id) === id);

      if (item) {
        item.cantidad = Math.max(0, Math.min(stock, Number(item.cantidad) + delta));
        if (item.cantidad === 0) cart.splice(cart.indexOf(item), 1);
      } else if (delta > 0 && stock > 0) {
        cart.push({ id, nombre, precio, imagen, cantidad: 1 });
      }

      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));
      actualizarCantidad();
    }

    btn?.addEventListener('click', () => {
      cambiarCantidad(1);
      if (btn.disabled) return;
      btn.textContent = '¡Añadido al Carrito! ✓';
      btn.classList.replace('bg-indigo-600', 'bg-emerald-600');
      setTimeout(() => {
        btn.textContent = 'Agregar al Carrito';
        btn.classList.replace('bg-emerald-600', 'bg-indigo-600');
      }, 1500);
    });
    menos?.addEventListener('click', () => cambiarCantidad(-1));
    mas?.addEventListener('click', () => cambiarCantidad(1));
    window.addEventListener('cart-updated', actualizarCantidad);
    actualizarCantidad();
  </script>
</MainLayout>