---
export const prerender = false;
import MainLayout from '../layouts/MainLayout.astro';
import { urlImagen } from '../lib/api';

let productos: any[] = [];
let categorias: any[] = [];
let errorCatalogo = false;

try {
  const response = await fetch(import.meta.env.PUBLIC_API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      query: `
        query ObtenerCatalogo {
          categorias {
            id
            nombre
          }
          productos(limit: 50) {
            items {
              id
              nombre
              descripcion
              precio
              stock
              imagen
              categoria {
                id
                nombre
              }
            }
          }
        }
      `
    })
  });

  const resultado = await response.json();
  if (resultado.data) {
    categorias = resultado.data.categorias || [];
    productos = resultado.data.productos?.items || [];
  }
  if (!response.ok || resultado.errors?.length) {
    throw new Error(resultado.errors?.[0]?.message || `La API respondió con HTTP ${response.status}`);
  }
} catch (error) {
  console.error("Error al cargar el catálogo:", error);
  errorCatalogo = true;
}
---

<MainLayout title="Catálogo - Tienda de Regalos">
  {errorCatalogo && (
    <div role="alert" class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-rose-800">
      <h1 class="font-bold">No se pudo cargar el catálogo</h1>
      <p class="mt-1 text-sm">
        Verifica que el backend esté conectado a PostgreSQL y que sus credenciales coincidan con las de la base de datos.
      </p>
    </div>
  )}

  <!-- Filtro de Categorías -->
  <section class="mb-6 flex gap-2 overflow-x-auto pb-2" id="categoryFilters">
    <button 
      data-cat="all" 
      class="cat-btn bg-indigo-600 text-white font-medium px-4 py-1.5 rounded-full text-sm shadow-sm transition-all"
    >
      Todas
    </button>
    {categorias.map((cat: any) => (
      <button 
        data-cat={cat.id} 
        class="cat-btn bg-white text-gray-700 border border-gray-200 font-medium px-4 py-1.5 rounded-full text-sm hover:bg-gray-50 transition-all"
      >
        {cat.nombre}
      </button>
    ))}
  </section>

  {(!errorCatalogo && productos.length === 0) && (
    <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-600">
      <h1 class="font-bold text-gray-900">Todavía no hay productos disponibles</h1>
      <p class="mt-1 text-sm">Comprueba que la base de datos esté inicializada con productos.</p>
    </div>
  )}

  <!-- Grilla de Productos -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="productsGrid">
    {productos.map((prod: any) => (
      <div 
        class="product-card bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col justify-between border border-gray-100"
        data-category={prod.categoria?.id || 'none'}
        data-name={prod.nombre.toLowerCase()}
      >
        <a href={`/producto/${prod.id}`} class="block group">
          <div class="h-48 w-full bg-gray-50 overflow-hidden">
            {prod.imagen ? (
              <img 
                src={urlImagen(prod.imagen) ?? undefined} 
                alt={prod.nombre} 
                class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
            ) : (
              <div class="h-full w-full flex items-center justify-center text-gray-400 text-sm">Sin imagen</div>
            )}
          </div>
          <div class="p-4">
            <h2 class="font-bold text-gray-900 text-base group-hover:text-indigo-600 transition-colors line-clamp-1">
              {prod.nombre}
            </h2>
            <p class="text-sm text-gray-600 mt-2 line-clamp-2">{prod.descripcion}</p>
            <p class="text-indigo-600 font-extrabold text-xl mt-2">${prod.precio} MXN</p>
            <p class="text-xs text-gray-500 mt-1">Stock: {prod.stock} unidades</p>
          </div>
        </a>

        <div class="p-4 pt-0">
          <div class="mb-3 flex items-center justify-between rounded-xl border border-gray-200 bg-gray-50 px-3 py-2">
            <span class="text-xs font-semibold text-gray-600">Cantidad en carrito</span>
            <div class="flex items-center gap-3">
              <button
                type="button"
                class="quantity-btn rounded-lg border border-gray-300 bg-white px-3 py-1 font-bold text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
                data-action="decrease"
                data-id={prod.id}
                aria-label={`Quitar una unidad de ${prod.nombre}`}
                disabled
              >−</button>
              <span class="product-quantity min-w-4 text-center text-sm font-bold text-gray-800" data-id={prod.id}>0</span>
              <button
                type="button"
                class="quantity-btn rounded-lg border border-gray-300 bg-white px-3 py-1 font-bold text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
                data-action="increase"
                data-id={prod.id}
                data-stock={prod.stock}
                aria-label={`Agregar una unidad de ${prod.nombre}`}
                disabled={prod.stock < 1}
              >+</button>
            </div>
          </div>
          <button 
            class="add-to-cart-btn w-full bg-indigo-600 text-white py-2 rounded-xl font-semibold text-sm hover:bg-indigo-700 transition-colors shadow-sm active:scale-95 transform disabled:cursor-not-allowed disabled:opacity-50"
            data-id={prod.id}
            data-nombre={prod.nombre}
            data-precio={prod.precio}
            data-imagen={urlImagen(prod.imagen)}
            data-stock={prod.stock}
            disabled={prod.stock < 1}
          >
            Agregar al Carrito
          </button>
        </div>
      </div>
    ))}
  </section>

  <script>
    function leerCarrito() {
      return JSON.parse(localStorage.getItem('cart') || '[]');
    }

    function actualizarControlesCantidad() {
      const cart = leerCarrito();
      document.querySelectorAll<HTMLElement>('.product-quantity').forEach((label) => {
        const id = label.dataset.id || '';
        const cantidad = Number(cart.find((item: any) => String(item.id) === id)?.cantidad || 0);
        const card = label.closest('.product-card');
        const stock = Number(card?.querySelector<HTMLButtonElement>('[data-action="increase"]')?.dataset.stock || 0);
        label.textContent = String(cantidad);
        const menos = card?.querySelector<HTMLButtonElement>('[data-action="decrease"]');
        const mas = card?.querySelector<HTMLButtonElement>('[data-action="increase"]');
        const agregar = card?.querySelector<HTMLButtonElement>('.add-to-cart-btn');
        if (menos) menos.disabled = cantidad <= 0;
        if (mas) mas.disabled = cantidad >= stock;
        if (agregar) agregar.disabled = stock < 1 || cantidad >= stock;
      });
    }

    function cambiarCantidad(id: string, delta: number, stock: number) {
      const cart = leerCarrito();
      const item = cart.find((product: any) => String(product.id) === id);
      if (item) {
        item.cantidad = Math.max(0, Math.min(stock, Number(item.cantidad) + delta));
        if (item.cantidad === 0) {
          cart.splice(cart.indexOf(item), 1);
        }
      } else if (delta > 0 && stock > 0) {
        const boton = document.querySelector<HTMLButtonElement>(`.add-to-cart-btn[data-id="${CSS.escape(id)}"]`);
        if (boton) {
          cart.push({
            id,
            nombre: boton.dataset.nombre,
            precio: Number(boton.dataset.precio),
            imagen: boton.dataset.imagen,
            cantidad: 1,
          });
        }
      }
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));
      actualizarControlesCantidad();
    }

    document.querySelectorAll<HTMLButtonElement>('.quantity-btn').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.id;
        if (!id) return;
        const stock = Number(button.dataset.stock || button.closest('.product-card')?.querySelector<HTMLButtonElement>('[data-action="increase"]')?.dataset.stock || 0);
        cambiarCantidad(id, button.dataset.action === 'increase' ? 1 : -1, stock);
      });
    });

    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id');
        if (!id) return;
        cambiarCantidad(id, 1, Number(target.dataset.stock || 0));

        // Feedback visual
        const originalText = target.textContent;
        target.textContent = '¡Añadido! ✓';
        target.classList.replace('bg-indigo-600', 'bg-emerald-600');
        setTimeout(() => {
          target.textContent = originalText;
          target.classList.replace('bg-emerald-600', 'bg-indigo-600');
        }, 1200);
      });
    });

    window.addEventListener('cart-updated', actualizarControlesCantidad);
    actualizarControlesCantidad();

    const catButtons = document.querySelectorAll('.cat-btn');
    const productCards = document.querySelectorAll('.product-card');

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('bg-indigo-600', 'text-white');
          b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        });

        btn.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        btn.classList.add('bg-indigo-600', 'text-white');

        const catId = btn.getAttribute('data-cat');
        productCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (catId === 'all' || cardCat === catId) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    searchInput?.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase();
      productCards.forEach(card => {
        const name = card.getAttribute('data-name') || '';
        if (name.includes(term)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  </script>
</MainLayout>