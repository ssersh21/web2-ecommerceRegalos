---
export const prerender = false;
import MainLayout from '../layouts/MainLayout.astro';
import { urlImagen } from '../lib/api';
import CatalogoInteractivo from '../components/CatalogoInteractivo';

let productos: any[] = [];
let categorias: any[] = [];
let errorCatalogo = false;

try {
  const response = await fetch(import.meta.env.PUBLIC_API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      query: `
        query ObtenerCatalogo {
          categorias {
            id
            nombre
          }
          productos(limit: 50) {
            items {
              id
              nombre
              descripcion
              precio
              stock
              imagen
              categoria {
                id
                nombre
              }
            }
          }
        }
      `
    })
  });

  const resultado = await response.json();
  if (resultado.data) {
    categorias = resultado.data.categorias || [];
    productos = resultado.data.productos?.items || [];
  }
  if (!response.ok || resultado.errors?.length) {
    throw new Error(resultado.errors?.[0]?.message || `La API respondió con HTTP ${response.status}`);
  }
} catch (error) {
  console.error("Error al cargar el catálogo:", error);
  errorCatalogo = true;
}
---

<MainLayout title="Catálogo - Tienda de Regalos">
  {errorCatalogo && (
    <div role="alert" class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-rose-800">
      <h1 class="font-bold">No se pudo cargar el catálogo</h1>
      <p class="mt-1 text-sm">
        Verifica que el backend esté conectado a PostgreSQL y que sus credenciales coincidan con las de la base de datos.
      </p>
    </div>
  )}

  {(!errorCatalogo && productos.length === 0) && (
    <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-600">
      <h1 class="font-bold text-gray-900">Todavía no hay productos disponibles</h1>
      <p class="mt-1 text-sm">Comprueba que la base de datos esté inicializada con productos.</p>
    </div>
  )}

  <CatalogoInteractivo
    client:load
    categorias={categorias}
    productos={productos.map((producto: any) => ({
      ...producto,
      precio: Number(producto.precio),
      stock: Number(producto.stock),
      imagen: urlImagen(producto.imagen),
    }))}
  />
</MainLayout>